HF_TOKEN=your_hugging_face_read_token
GROQ_API_KEY=
# Choose an active model that supports JSON object mode in your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
AEGIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Pin a Hugging Face commit/revision for reproducible deployments.
AEGIS_EMBEDDING_REVISION=main
AEGIS_KB_DIR=data/knowledge_base
AEGIS_INDEX_DIR=var/indexes/aegis
AEGIS_TOP_K_DOCUMENTS=3
# Starting value only; tune on development examples, then freeze for held-out eval.
AEGIS_MIN_SIMILARITY=0.25
AEGIS_CHUNK_TOKENS=160
AEGIS_CHUNK_OVERLAP=24
AEGIS_PROVIDER_TIMEOUT=20

AEGIS_REDIS_URL=redis://127.0.0.1:6379/0
AEGIS_REDIS_PREFIX=aegis
AEGIS_SESSION_TTL=86400
AEGIS_CLASSIFIER_TTL=300
AEGIS_CLASSIFIER_MAX_ENTRIES=1000
AEGIS_TURN_TIMEOUT=60
AEGIS_MAX_ACTIVE_PER_WORKER=32
AEGIS_PROVIDER_CONCURRENCY=16
AEGIS_EMBEDDING_WORKERS=2
AEGIS_MAX_EMBEDDING_PENDING=4
# Choose distinct local DEMO tokens, not production credentials.
AEGIS_DEMO_CUSTOMER_A_TOKEN=
AEGIS_DEMO_CUSTOMER_B_TOKEN=
# Optional: pin the trusted demo clock for reproducible order fixtures.
AEGIS_DEMO_AS_OF=2026-10-16

AEGIS_ADMIN_TOKEN=abcde
# Optional, only for running-call failure demonstrations; default is false.
AEGIS_ENABLE_DEMO_FAULTS=false