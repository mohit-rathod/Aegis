# Reference only: merge needed settings into your EXISTING .env.
# Do not replace real keys with these blank values.
GROQ_API_KEY=
HF_TOKEN=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
AEGIS_REDIS_URL=redis://127.0.0.1:6379/0
AEGIS_REDIS_PREFIX=aegis
AEGIS_SESSION_TTL=86400
AEGIS_CLASSIFIER_TTL=300
AEGIS_CLASSIFIER_MAX_ENTRIES=1000
AEGIS_TURN_TIMEOUT=60
AEGIS_MAX_ACTIVE_PER_WORKER=32
AEGIS_PROVIDER_CONCURRENCY=16
AEGIS_EMBEDDING_WORKERS=2
AEGIS_MAX_EMBEDDING_PENDING=4
AEGIS_DEMO_CUSTOMER_A_TOKEN=
AEGIS_DEMO_CUSTOMER_B_TOKEN=
AEGIS_ADMIN_TOKEN=
AEGIS_DEMO_AS_OF=2026-10-16

# Voice channel (optional dependencies: pip install -e '.[voice]')
# Run python scripts/setup_voice.py once before enabling voice.
AEGIS_VAD_MODEL=var/models/silero_vad.onnx
AEGIS_TTS_MODEL=var/models/en_US-lessac-medium.onnx
AEGIS_STT_LANGUAGE=en
AEGIS_VOICE_ONSET_MS=160
AEGIS_VOICE_SILENCE_MS=768
AEGIS_STT_TIMEOUT=12
AEGIS_TTS_TIMEOUT=30
AEGIS_VOICE_MAX_CONNECTIONS=32
AEGIS_SPEECH_CONCURRENCY=4

# Explicit local demo only: enable admin one-shot provider failure controls.
AEGIS_ENABLE_DEMO_FAULTS=false
